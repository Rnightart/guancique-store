# Server
PORT=4000
NODE_ENV=development

# Set to true so this same Express process also serves the frontend files
# (single server, single port, no CORS needed). Set to false to keep running
# the frontend separately (Live Server, Nginx, etc).
SERVE_FRONTEND=true

# Frontend origin allowed to call this API (only matters when SERVE_FRONTEND=false)
FRONTEND_URL=http://localhost:5500

# Session
SESSION_SECRET=change-this-to-a-long-random-string
SESSION_MAX_AGE_MS=604800000

# SQLite database file location (created automatically on first run)
DATABASE_PATH=./db/gancique.sqlite

# First admin account, created automatically if it doesn't exist yet
ADMIN_EMAIL=admin@ganciquestore.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Store Admin
